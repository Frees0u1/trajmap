{
  "name": "trajmap",
  "version": "0.1.5",
  "description": "Render GPS routes (encoded polylines, e.g. from Strava) as PNG map images in Node.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "gps",
    "trajectory",
    "route",
    "polyline",
    "polyline-to-image",
    "static-map",
    "map-image",
    "png",
    "strava",
    "cycling",
    "running",
    "map-tiles",
    "carto",
    "canvas",
    "geospatial"
  ],
  "author": "loskyer <loskyer@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Frees0u1/trajmap.git"
  },
  "homepage": "https://github.com/Frees0u1/trajmap#readme",
  "bugs": {
    "url": "https://github.com/Frees0u1/trajmap/issues"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.1.1",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@mapbox/sphericalmercator": "^2.0.1",
    "@types/node": "^24.3.0",
    "axios": "^1.11.0",
    "canvas": "^3.2.0"
  }
}
